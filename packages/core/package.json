{
  "name": "@gg-web-engine/core",
  "version": "0.0.81",
  "description": "Library-agnostic 2D/3D game engine core for the browser: worlds, entities, clocks, input, level loader and networking contracts. Pair it with one rendering and one physics adapter",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js"
  ],
  "scripts": {
    "test": "jest",
    "prettier-format": "prettier --config ../../.prettierrc 'src/**/*.ts' --write",
    "prepublish": "rm -rf ./dist/ && npm run build",
    "update-version": "VERSION=$(grep '\"version\":' package.json | sed -E 's/.*\"version\": *\"([^\"]+)\".*/\\1/') && echo \"export const VERSION = '$VERSION';\" > src/version.ts",
    "build": "npm run update-version && tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyGura/gg-web-engine.git"
  },
  "keywords": [
    "game-engine",
    "gamedev",
    "game-development",
    "browser-game",
    "typescript",
    "webgl",
    "game-engine-framework",
    "2d",
    "3d",
    "physics",
    "level-editor",
    "json-levels",
    "character-controller",
    "vehicle",
    "multiplayer",
    "threejs",
    "pixijs",
    "rapier",
    "ammo",
    "matter-js"
  ],
  "author": "AndyGura",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/AndyGura/gg-web-engine/issues"
  },
  "homepage": "https://github.com/AndyGura/gg-web-engine#readme",
  "dependencies": {
    "rxjs": "7.8.2",
    "stats.js": "0.17.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/stats.js": "^0.17.4",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "setupFiles": [
      "<rootDir>/test/jest.polyfills.ts"
    ],
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/dist/",
      "<rootDir>/test/"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "jsdom"
  }
}
