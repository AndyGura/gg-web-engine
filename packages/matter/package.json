{
  "name": "@gg-web-engine/matter",
  "version": "0.0.81",
  "description": "Matter.js 2D physics adapter for gg-web-engine: rigid bodies, triggers and character controller",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/matter-rigid-body-builder.js"
  ],
  "scripts": {
    "test": "jest",
    "prettier-format": "prettier --config ../../.prettierrc 'src/**/*.ts' --write",
    "prepublish": "rm -rf ./dist/ && tsc",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyGura/gg-web-engine.git"
  },
  "keywords": [
    "game-engine",
    "gamedev",
    "game-development",
    "browser-game",
    "typescript",
    "matter-js",
    "matter",
    "physics",
    "2d",
    "character-controller",
    "platformer"
  ],
  "author": "AndyGura",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/AndyGura/gg-web-engine/issues"
  },
  "homepage": "https://github.com/AndyGura/gg-web-engine#readme",
  "dependencies": {
    "@types/matter-js": "0.20.2",
    "matter-js": "0.20.0",
    "poly-decomp": "^0.3.0"
  },
  "devDependencies": {
    "@gg-web-engine/core": "0.0.81",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.9.6",
    "rxjs": "7.8.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@gg-web-engine/core": "0.0.81",
    "rxjs": "7.8.2"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "@gg-web-engine/core": "<rootDir>/../core/src/index.ts"
    },
    "preset": "ts-jest/presets/default",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/dist/",
      "<rootDir>/test/"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "jsdom"
  }
}
